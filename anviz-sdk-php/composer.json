{
    "name": "anviz/sdk-php",
    "description": "PHP SDK für Anviz Biometric Devices - Portiert von MxLabs/Anviz",
    "type": "library",
    "keywords": ["anviz", "biometric", "attendance", "access-control", "fingerprint", "tcp"],
    "license": "MIT",
    "authors": [
        {
            "name": "Anviz PHP SDK Contributors"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-sockets": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "phpstan/phpstan": "^1.0",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Anviz\\SDK\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit tests/",
        "lint": "phpstan analyse src/",
        "cs-check": "phpcs src/ --standard=PSR12",
        "cs-fix": "phpcbf src/ --standard=PSR12"
    }
}
